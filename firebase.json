{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/node_modules/**",
      ".DS_Store",
      "**/.DS_Store"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": {
          "functionId": "contactStelli",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/launch-updates",
        "function": {
          "functionId": "subscribeToLaunchUpdates",
          "region": "us-central1"
        }
      },
      {
        "source": "/how-to",
        "destination": "/how-to.html"
      },
      {
        "source": "/privacypolicy",
        "destination": "/privacypolicy.html"
      },
      {
        "source": "/termsofservice",
        "destination": "/termsofservice.html"
      },
      {
        "source": "/communityguidelines",
        "destination": "/communityguidelines.html"
      },
      {
        "source": "/auth",
        "destination": "/auth.html"
      },
      {
        "source": "/e/**",
        "destination": "/invite.html"
      }
    ],
    "predeploy": [
      "python3 scripts/build_site.py"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "stelli-website",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        "test"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5012
    },
    "firestore": {
      "port": 8182
    },
    "hosting": {
      "port": 5013
    },
    "ui": {
      "enabled": false
    },
    "hub": {
      "port": 4412
    },
    "logging": {
      "port": 4512
    }
  }
}
